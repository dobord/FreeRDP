[Unit]
Description=FreeRDP PAM/SSSD/NLA Server
After=network.target

[Service]
EnvironmentFile=-@CMAKE_INSTALL_FULL_SYSCONFDIR@/frdpd/frdpd.env
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/frdpd --config @CMAKE_INSTALL_FULL_SYSCONFDIR@/frdpd/frdpd.toml $FRDPD_ARGS
User=root
Group=root
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
LimitNOFILE=1024
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
