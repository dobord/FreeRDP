+static void fill_random(uint8_t random_bytes[FRDP_AUTHZ_TOKEN_BYTES], uint8_t seed)
+{
+    for (size_t index = 0; index < FRDP_AUTHZ_TOKEN_BYTES; index++)
+        random_bytes[index] = (uint8_t)(seed + index);
+}
+
+static int issue(frdpAuthzStore *store, uint64_t now, uint8_t seed, const char *correlation_id,
+                 const char *user, const char *rhost, char token[FRDP_AUTHZ_TOKEN_SIZE],
+                 uint64_t *expires_at)
+{
+    uint8_t random_bytes[FRDP_AUTHZ_TOKEN_BYTES];
+
+    fill_random(random_bytes, seed);
+    return frdp_authz_issue(store, now, random_bytes, correlation_id, user, rhost, 1001U, 1002U,
+                            token, FRDP_AUTHZ_TOKEN_SIZE, expires_at) == FRDP_AUTHZ_OK
+               ? 0
+               : -1;
+}
+
+static int test_issue_consume_and_replay(void)
+{
+    frdpAuthzStore store;
+    frdpAuthzIdentity identity;
+    char token[FRDP_AUTHZ_TOKEN_SIZE] = { 0 };
+    uint64_t expires_at = 0U;
+
+    frdp_authz_store_init(&store, 30U);
+    if (issue(&store, 100U, 1U, "11111111-1111-4111-8111-111111111111", "alice",
+              "client.example", token, &expires_at) != 0)
+        return -1;
+    if (expires_at != 130U || strlen(token) != FRDP_AUTHZ_TOKEN_SIZE - 1U)
+        return -1;
+    if (frdp_authz_consume(&store, 110U, token, "11111111-1111-4111-8111-111111111111",
+                           "alice", "client.example", &identity) != FRDP_AUTHZ_OK)
+        return -1;
+    if (strcmp(identity.user, "alice") != 0 || identity.uid != 1001U || identity.gid != 1002U ||
+        identity.expires_at != expires_at)
+        return -1;
+    if (frdp_authz_consume(&store, 111U, token, "11111111-1111-4111-8111-111111111111",
+                           "alice", "client.example", &identity) != FRDP_AUTHZ_REPLAY)
+        return -1;
+    frdp_authz_store_clear(&store);
+    return 0;
+}
