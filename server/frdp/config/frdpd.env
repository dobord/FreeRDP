# Optional extra arguments consumed by frdpd.service.
#
# Normal startup uses auth_socket and session_socket from frdpd.toml.
# In-process PAM fallback is intentionally not available in normal builds.
# Local development of that legacy path requires configuring CMake with
# -DWITH_FRDPD_IN_PROCESS_PAM=ON and a config without helper socket entries.
FRDPD_ARGS=
