# Example configuration for frdpd
[server]
listen = "0.0.0.0:3389"
security = "nla"
tls_cert = "/etc/frdpd/tls.crt"
tls_key = "/etc/frdpd/tls.key"
# 0 or omitted means unlimited accepted peer workers.
# max_connections = 64

[auth]
mode = "pam-sssd"
pam_service = "frdpd"
auth_socket = "/run/frdp-authd/authd.sock"
# NTLM is available when FreeRDP is built with WITH_FRDPD_NTLM=ON (the default).
# Set false to ask CredSSP/Negotiate to reject NTLM and use Kerberos mechanisms only.
ntlm_fallback = @FRDP_CONFIG_NTLM_FALLBACK@
# When active, the SAM file contains password-equivalent NT hashes and must be a
# regular, single-link, owner-only 0600 file owned by the frdpd service account.
@FRDP_CONFIG_NTLM_SAM_FILE@
# Kerberos identity fields are validated, but kerberos=true fails closed until the
# integrated CredSSP/SPNEGO acceptor path is implemented.
# kerberos = false
# keytab = "/etc/frdpd/frdpd.keytab"
# accepted_spn = "TERMSRV/rdp01.example.com"

[session]
session_socket = "/run/frdp-sesmand/sesmand.sock"
# Xvfb remains the compatibility default. For real single-monitor resize, install
# the Xorg dummy driver and select the trusted absolute server/config paths:
display_backend = "xvfb"
# display_backend = "xorg-dummy"
# xorg_path = "/usr/lib/xorg/Xorg"
# xorg_config = "/usr/share/frdpd/xorg-dummy.conf"
# Optional cap on all sessions managed by frdp-sesmand, including disconnected
# sessions retained for reconnect. 0 or omission means unlimited.
# max_sessions = 64
# Optional POSIX resource-limit guards for newly launched session agents.
# With systemd_scope=true the same values also become TasksMax/MemoryMax.
# 0 or omission means unlimited.
# max_processes = 256
# memory_max_mb = 4096
# Place each new desktop agent and its descendants in a fail-closed transient
# systemd scope before exec. Keep false without a usable system manager/bus.
# systemd_scope = false
# Register each new desktop as a remote login1 session. This is an alternative
# to systemd_scope and requires pam_systemd.so to be absent from the PAM stack.
# logind_session = false
# Optional CPU capacity for that scope as a percentage. 100 is one CPU and
# values above 100 permit multiple CPUs. Requires systemd_scope=true.
# cpu_quota_percent = 100
# agent_heartbeat_interval_ms = 5000
# agent_heartbeat_timeout_ms = 500
# agent_heartbeat_failures = 3

# [channels]
# Channel filtering defaults to blocklist mode with empty lists.
# static_mode = "blocklist"
# static_deny = ""
# dynamic_mode = "blocklist"
# dynamic_deny = ""
# Dynamic channel lists feed the DVC authorization callback for implemented handlers.
# Use allowlist mode to permit only exact channel names:
# static_mode = "allowlist"
# static_allow = "cliprdr"
# Allowing a name only permits negotiation; runtime gates still deny handlers that
# are not implemented yet, including arbitrary static channels, rdpsnd audio
# output, and rdpdr device redirection.
# drdynvc remains guard-denied until transport and useful handlers are enabled.

# [clipboard]
# Clipboard defaults to disabled. Text mode requires an explicit direction and
# a bounded maximum payload before a runtime handler can be enabled.
# mode = "disabled"
# direction = "disabled"
# max_text_bytes = 65536

# [audit]
# Structured audit sinks are not implemented yet, so only explicit disabled
# policy is accepted. enabled = true fails closed until runtime enforcement exists.
# enabled = false
