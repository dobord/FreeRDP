# PAM service for the experimental FreeRDP RDP server.
#
# This stack is intentionally non-interactive: CredSSP/NLA supplies the
# password before PAM starts, and frdpd is not a general PAM prompt transport.
# Review site policy before enabling MFA or modules that require extra prompts.

auth      required   pam_env.so
auth      sufficient pam_sss.so use_first_pass
auth      required   pam_deny.so

account   required   pam_sss.so

session   required   pam_limits.so
session   optional   pam_systemd.so
session   required   pam_sss.so

password  sufficient pam_sss.so use_authtok
