FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        dnsutils \
        krb5-user \
        procps \
        samba \
        samba-ad-provision \
        samba-dsdb-modules \
        samba-vfs-modules \
        smbclient \
        winbind \
    && rm -rf /var/lib/apt/lists/*

COPY server/frdp/test/e2e/scripts/samba-entrypoint.sh /usr/local/sbin/frdp-e2e-samba-entrypoint
RUN chmod 0755 /usr/local/sbin/frdp-e2e-samba-entrypoint

ENTRYPOINT ["bash", "/usr/local/sbin/frdp-e2e-samba-entrypoint"]
