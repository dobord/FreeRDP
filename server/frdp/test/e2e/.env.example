# Test-only credentials. Never reuse these values outside an isolated E2E network.
FRDP_TEST_USER=rdpuser
FRDP_TEST_PASSWORD=RdpPassw0rd!
FRDP_TEST_GROUP=rdp-users
FRDP_DENY_USER=rdpdisabled
FRDP_DENY_PASSWORD=DeniedPassw0rd!
FRDP_IPA_ADMIN_PASSWORD=IpaAdminPassw0rd!
FRDP_FREEIPA_ENROLL_PASSWORD=IpaEnrollPassw0rd!
FRDP_AD_ADMIN_PASSWORD=SambaAdminPassw0rd!

# Change the complete address set together when this subnet conflicts locally.
FRDP_E2E_SUBNET=172.31.56.0/24
FRDP_IPA_IP=172.31.56.10
FRDP_AD_DC_IP=172.31.56.20
FRDP_LOCAL_SERVER_IP=172.31.56.30
FRDP_FREEIPA_SERVER_IP=172.31.56.31
FRDP_SAMBA_SERVER_IP=172.31.56.32
FRDP_LOCAL_CLIENT_IP=172.31.56.40
FRDP_FREEIPA_CLIENT_IP=172.31.56.41
FRDP_SAMBA_CLIENT_IP=172.31.56.42

# Optional image and artifact overrides.
FRDP_E2E_IMAGE=frdpd-e2e:dev
# Supported values: openbox, xfce, mate, lxqt, plasma, gnome.
FRDP_DESKTOP_TYPE=openbox
FRDP_FREEIPA_BASE_IMAGE=quay.io/freeipa/freeipa-server:rocky-9
FRDP_E2E_ARTIFACTS=./artifacts
